# Copy to .env, set values for your installation, and keep .env private.
SCHOOLCLOUD_API_URL=https://main.niedersachsen.schulcloud-verbund.org/api
SCHOOLCLOUD_AUTH_METHOD=local
SCHOOLCLOUD_USERNAME=your-username
SCHOOLCLOUD_PASSWORD=your-password
# Optional cached JWT for SHD v3 commands; obtain with `svs auth --shd --print-token`.
# SCHOOLCLOUD_SHD_TOKEN=your-shd-jwt

# Optional elevated JWT for `svs school ...`; otherwise the regular token/login is used.
# SVS_ADMIN_TOKEN=your-admin-jwt

# Internal SHD Admin API (for `svs shd ... create`); use a port-forward if cluster-only.
SVS_ADMIN_API_URL=http://localhost:4030/admin/api
SCHOOLCLOUD_ADMIN_API_KEY=your-internal-admin-api-key

# For LDAP accounts, set SCHOOLCLOUD_AUTH_METHOD=ldap and also provide:
# SCHOOLCLOUD_SCHOOL_ID=...
# SCHOOLCLOUD_SYSTEM_ID=...
