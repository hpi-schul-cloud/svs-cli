# Copy to .env, set values for your installation, and keep .env private.
SCHOOLCLOUD_API_URL=https://main.niedersachsen.schulcloud-verbund.org/api
SCHOOLCLOUD_AUTH_METHOD=local
SCHOOLCLOUD_USERNAME=your-username
SCHOOLCLOUD_PASSWORD=your-password

# For LDAP accounts, set SCHOOLCLOUD_AUTH_METHOD=ldap and also provide:
# SCHOOLCLOUD_SCHOOL_ID=...
# SCHOOLCLOUD_SYSTEM_ID=...
